<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>edge104_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>10.21.31.104</address>
      </interfaceWhiteList>
      <sendBufferSize>8388608</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
      <!-- Fragment at RTPS level below Ethernet MTU for the 104 -> NX output. -->
      <maxMessageSize>1400</maxMessageSize>
      <non_blocking_send>true</non_blocking_send>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>edge104_shm</transport_id>
      <type>SHM</type>
      <segment_size>500000000</segment_size>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="edge104_default" is_default_profile="true">
    <rtps>
      <builtin>
        <discovery_config>
          <discoveryProtocol>SIMPLE</discoveryProtocol>
          <EDP>SIMPLE</EDP>
          <simpleEDP>
            <PUBWRITER_SUBREADER>true</PUBWRITER_SUBREADER>
            <PUBREADER_SUBWRITER>true</PUBREADER_SUBWRITER>
          </simpleEDP>
        </discovery_config>
      </builtin>
      <userTransports>
        <transport_id>edge104_udp</transport_id>
        <transport_id>edge104_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
